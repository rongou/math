  patch=root/"patches"/(name+"-lean4341.patch")
  if patch.is_file():
   result=subprocess.run(["git","-C",str(p),"apply","--check","--reverse",str(patch)],capture_output=True,text=True)
   row["compatibility_patch"]={"path":str(patch.relative_to(root)),"sha256":hashlib.sha256(patch.read_bytes()).hexdigest(),"reverse_check_exit_status":result.returncode,"applied":result.returncode==0}
 rows.append(row)
 print(json.dumps(row,ensure_ascii=False))
(scratch/"resolved_dependencies.json").write_text(json.dumps(rows,indent=2,ensure_ascii=False)+"\n")
print("SUMMARY",json.dumps({"package_count":len(rows),"present":sum(r["checkout_exists"] for r in rows),"matching_revisions":sum(r.get("revision_matches_lock",False) for r in rows),"dirty_checkouts":sum(bool(r.get("worktree_status")) for r in rows)}))
