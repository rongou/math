for entry in manifest["packages"]:
 name=entry["name"].strip("«»")
 p=root/".lake/packages"/name
 row={**entry,"checkout_path":str(p),"checkout_exists":p.is_dir()}
 if p.is_dir():
  for key,args in [("actual_revision",["rev-parse","HEAD"]),("actual_origin",["remote","get-url","origin"]),("worktree_status",["status","--porcelain"])]:
   r=subprocess.run(["git","-C",str(p),*args],capture_output=True,text=True)
   row[key]=r.stdout.strip()
