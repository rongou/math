     6	
     7	universe uV uS uK uGamma uQ
     8	
     9	abbrev Cube (V : Type uV) := V → Bool
    10	abbrev Literal (V : Type uV) := V × Bool
    11	
    12	variable {V : Type uV}
    13	
    14	namespace Literal
    15	
    16	def eval (l : Literal V) (x : Cube V) : Bool := decide (x l.1 = l.2)
    17	
    18	end Literal
    19	
    20	abbrev GateInput (V : Type uV) := Sum (Literal V) Bool
    21	abbrev RawClause (V : Type uV) := List (GateInput V)
    22	
    23	namespace GateInput
    24	
    25	def eval : GateInput V → Cube V → Bool
    26	  | .inl l, x => l.eval x
    27	  | .inr b, _ => b
    28	
    29	end GateInput
    30	
    31	namespace RawClause
    32	
    33	noncomputable def eval (C : RawClause V) (x : Cube V) : Bool := by
    34	  classical
    35	  exact decide (∃ l ∈ C, l.eval x = true)
    36	
    37	end RawClause
    38	
    39	structure Circuit3 (V : Type uV) where
    40	  bottomCount : ℕ
    41	  middleCount : ℕ
    42	  bottom : Fin bottomCount → RawClause V
    43	  middle : Fin middleCount → Finset (Fin bottomCount)
    44	  top : Finset (Fin middleCount)
    45	
    46	namespace Circuit3
    47	
    48	def gateCount (C : Circuit3 V) : ℕ := C.bottomCount + C.middleCount + 1
    49	
    50	noncomputable def middleEval (C : Circuit3 V) (j : Fin C.middleCount)
    51	    (x : Cube V) : Bool := by
    52	  classical
    53	  exact decide (∀ i ∈ C.middle j, (C.bottom i).eval x = true)
    54	
    55	noncomputable def eval (C : Circuit3 V) (x : Cube V) : Bool := by
    56	  classical
    57	  exact decide (∃ j ∈ C.top, C.middleEval j x = true)
    58	
    59	def Computes (C : Circuit3 V) (f : Cube V → Bool) : Prop := ∀ x, C.eval x = f x
    60	
    61	end Circuit3
    62	
    63	def runSteps {S : Type uS} (step : S → Option S) (n : ℕ) (c : Option S) : Option S :=
    64	  (fun oc => oc.bind step)^[n] c
    65	
    66	inductive HeadMove
