     8	theorem exists_polynomial_time_language_depth_three_lower_bound :
     9	    ∃ (L : List Bool → Bool) (M : FiniteMultiTapeMachine) (C a : ℕ),
    10	      0 < C ∧ 0 < a ∧
    11	      (∀ w : List Bool, MultiTapeHaltsIn M w (L w) (C * (w.length + 1) ^ a)) ∧
    12	      ∀ A : ℝ, 0 < A → ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
    13	        ∀ D : Circuit3 (Fin n), D.Computes (fun x => L (List.ofFn x)) →
    14	          (2 : ℝ) ^ (A * Real.sqrt (n : ℝ)) < (D.gateCount : ℝ) := by
    15	  obtain ⟨M, C, a, hC, ha, hM⟩ := language_polynomial_time
    16	  exact ⟨language, M, C, a, hC, ha, hM, language_depth_three_gate_lower_bound⟩
