    71	def HeadMove.apply {Γ : Type uGamma} [Inhabited Γ] : HeadMove → Turing.Tape Γ → Turing.Tape Γ
    72	  | .left, t => t.move Turing.Dir.left
    73	  | .stay, t => t
    74	  | .right, t => t.move Turing.Dir.right
    75	
    76	structure MultiTapeCfg (K : Type uK) (Γ : Type uGamma) (Q : Type uQ) [Inhabited Γ] where
    77	  q : Q
    78	  tapes : K → Turing.Tape Γ
    79	
    80	abbrev MultiTapeCode (K : Type uK) (Γ : Type uGamma) (Q : Type uQ) :=
    81	  Q → (K → Γ) → Option (Q × (K → Γ) × (K → HeadMove))
    82	
    83	def multiTapeUpdate {K : Type uK} {Γ : Type uGamma} {Q : Type uQ} [Inhabited Γ] (c : MultiTapeCfg K Γ Q)
    84	    (q : Q) (writes : K → Γ) (moves : K → HeadMove) : MultiTapeCfg K Γ Q :=
    85	  ⟨q, fun k => (moves k).apply ((c.tapes k).write (writes k))⟩
    86	
    87	def multiTapeStep {K : Type uK} {Γ : Type uGamma} {Q : Type uQ} [Inhabited Γ] (code : MultiTapeCode K Γ Q)
    88	    (c : MultiTapeCfg K Γ Q) : Option (MultiTapeCfg K Γ Q) :=
    89	  (code c.q (fun k => (c.tapes k).head)).map fun out =>
    90	    multiTapeUpdate c out.1 out.2.1 out.2.2
    91	
    92	structure FiniteMultiTapeMachine where
