for old in json.loads((SCRATCH/'resolved_dependencies.json').read_text()):
 p=pathlib.Path(old['checkout_path'])
 rev=subprocess.check_output(['git','-C',str(p),'rev-parse','HEAD'],text=True).strip()
 status=subprocess.check_output(['git','-C',str(p),'status','--porcelain'],text=True).strip()
