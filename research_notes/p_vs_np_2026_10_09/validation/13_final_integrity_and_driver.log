head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()
diff=subprocess.run(['git','diff','--exit-code','HEAD','--'],cwd=ROOT,capture_output=True,text=True)
status=subprocess.run(['git','status','--short'],cwd=ROOT,capture_output=True,text=True)
print('FINAL_GIT_HEAD',head)
print('FINAL_GIT_DIFF_EXIT_STATUS',diff.returncode)
print('FINAL_GIT_DIFF_OUTPUT',diff.stdout,diff.stderr)
print('FINAL_GIT_STATUS',status.stdout)
result=dict(
 source_commit=COMMIT, final_head=head, head_matches_requested_commit=head==COMMIT,
 original_tracked_diff_exit_status=diff.returncode, original_tracked_diff=diff.stdout,
 original_git_status=status.stdout, original_lake_cache_created=(ROOT/'lean/.lake').exists(),
 fingerprints=fingerprints,
 local_source_modules_checked=len(local), local_source_integrity=local,
 all_local_source_bytes_unchanged=all(r['original_matches_baseline'] and r['snapshot_matches_baseline'] for r in local),
 local_olean_count=sum(r['olean_exists'] for r in local),
 actual_axioms=axioms, target_compiled_artifacts=artifacts,
