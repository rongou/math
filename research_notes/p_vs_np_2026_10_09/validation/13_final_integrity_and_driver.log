scratch = pathlib.Path(__file__).resolve().parent
root = pathlib.Path('/home/rou/src/math')
out = root / 'research_notes/p_vs_np_2026_10_09/validation'
label, cwd, limit, command = sys.argv[1:]
log = out / (label + '.log')
if log.exists():
    raise SystemExit(f'Refusing to overwrite existing log: {log}')
start = datetime.datetime.now(datetime.timezone.utc).isoformat()
t0 = time.monotonic()
with log.open('x') as f:
    f.write(f'START_UTC: {start}\nCWD: {cwd}\nTIMEOUT_SECONDS: {limit}\nSHELL: bash --noprofile --norc -c\nCOMMAND:\n{command}\n\nOUTPUT (stdout and stderr merged):\n')
    f.flush()
    p = subprocess.Popen(['bash', '--noprofile', '--norc', '-c', command], cwd=cwd, stdout=f, stderr=subprocess.STDOUT, start_new_session=True)
    timed_out = False
    try:
        code = p.wait(timeout=float(limit))
    except subprocess.TimeoutExpired:
        timed_out = True
        os.killpg(p.pid, signal.SIGTERM)
        try:
            code = p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL)
            code = p.wait()
    elapsed = time.monotonic() - t0
    end = datetime.datetime.now(datetime.timezone.utc).isoformat()
    f.write(f'\nEND_UTC: {end}\nEXIT_STATUS: {code}\nTIMED_OUT: {str(timed_out).lower()}\nELAPSED_SECONDS: {elapsed:.3f}\n')
record = dict(label=label, cwd=cwd, shell='bash --noprofile --norc -c', command=command, timeout_seconds=float(limit), start_utc=start, end_utc=end, exit_status=code, timed_out=timed_out, elapsed_seconds=round(elapsed,3), log=str(log.relative_to(root)))
with (scratch / 'commands.jsonl').open('a') as f:
