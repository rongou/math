 all_dependency_revisions_still_match=all(r['revision_matches_lock'] for r in final_dependencies),
 dependency_worktrees_unchanged_after_snapshot_inventory=all(r['worktree_status_unchanged'] for r in final_dependencies),
)
(SCRATCH/'final_integrity.json').write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
print('INTEGRITY_SUMMARY',json.dumps({k:v for k,v in result.items() if k not in ('fingerprints','local_source_integrity','final_dependency_integrity','actual_axioms','target_compiled_artifacts')}))
assert result['head_matches_requested_commit']
assert diff.returncode==0
assert all(r['unchanged'] and r['snapshot_unchanged'] for r in fingerprints)
assert result['all_local_source_bytes_unchanged']
