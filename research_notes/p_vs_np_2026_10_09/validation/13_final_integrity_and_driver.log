 axioms[name]=[a.strip() for a in raw.split(',')]
for target in config['theorem_names']:
 assert target in axioms
 assert set(axioms[target])<=set(config['permitted_axioms'])
print('ACTUAL_AXIOMS',json.dumps(axioms))
