#!/usr/bin/env python3
"""Conservative lexical/import scan, not a Lean parser or kernel verification."""
import collections, hashlib, json, pathlib, re
ROOT = pathlib.Path('/home/rou/src/math')
SCRATCH = pathlib.Path('/tmp/family112-build-validation.xWSfhA')
LEAN = SCRATCH / 'project/lean'
COMMIT = 'fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb'
SOLUTION = 'OAI.Computability.DepthThree.Main'
CHALLENGE = 'ComparatorChallenges.DepthThree'

def mask_noncode(text):
    """Mask nested /- -/ comments, -- comments, strings; preserve offsets/newlines.
    Lean escaped identifiers are retained. Character literals are not removed:
    this intentionally errs toward false-positive token hits rather than silence.
    """
    result = list(text)
    i = 0
    def mask(a, b):
        for k in range(a, b):
            if result[k] != '\n':
                result[k] = ' '
    while i < len(text):
        if text.startswith('/-', i):
            start, level = i, 1
            i += 2
            while i < len(text) and level:
                if text.startswith('/-', i): level, i = level + 1, i + 2
                elif text.startswith('-/', i): level, i = level - 1, i + 2
                else: i += 1
            mask(start, i)
        elif text.startswith('--', i):
            start = i
            i = text.find('\n', i)
            if i < 0: i = len(text)
            mask(start, i)
        elif text[i] == '"':
            start = i
            i += 1
            while i < len(text):
                if text[i] == '\\': i += 2
                elif text[i] == '"': i += 1; break
                else: i += 1
            i = min(i, len(text))
            mask(start, i)
        else: i += 1
    return ''.join(result)

IMPORT = re.compile(r'^\s*(?:(?:public|private|meta)\s+)*import\s+([^\n]+)', re.M)
NAME = re.compile(r'[\w\u00ab\u00bb.]+')
PATTERNS = {
    'proof_placeholder': r'(?<![\w\'])\b(?:sorry|admit|sorryAx)\b(?![\w\'])',
    'axiom_declaration': r'(?<![\w\'])\baxiom\b(?![\w\'])',
    'native_or_reduction_trust': r'(?<![\w\'])\b(?:native_decide|native_decide\w*|ofReduceBool|ofReduceNat|ofReduceEq|trustCompiler)\b',
    'unsafe_or_external_implementation': r'(?<![\w\'])\b(?:unsafe|implemented_by|extern)\b',
    'metaprogramming_command': r'(?<![\w\'])\b(?:run_tac|run_elab|run_cmd|initialize|builtin_initialize|elab|macro|macro_rules|elab_rules)\b',
    'trust_related_option': r'\b(?:debug\.)?(?:skipKernelTC|trustLevel|kernel\.trustLean)\b',
}

def inspect(module):
    path = LEAN / (module.replace('.', '/') + '.lean')
    raw = path.read_text()
    code = mask_noncode(raw)
    imports = []
    for match in IMPORT.finditer(code):
        for name in NAME.findall(match.group(1)):
            imports.append(name)
    hits = []
    for category, pattern in PATTERNS.items():
        for match in re.finditer(pattern, code):
            line = code.count('\n', 0, match.start()) + 1
            hits.append(dict(category=category, token=match.group(), line=line, source=raw.splitlines()[line-1].strip()))
    opts = [dict(line=code.count('\n',0,m.start())+1, source=raw.splitlines()[code.count('\n',0,m.start())].strip())
            for m in re.finditer(r'^\s*set_option\s+[^\n]+', code, re.M)]
    pathrel = 'lean/' + str(path.relative_to(LEAN))
    current = ROOT / pathrel
    return dict(module=module, path=pathrel, sha256=hashlib.sha256(path.read_bytes()).hexdigest(),
                bytes=path.stat().st_size, lines=len(raw.splitlines()), imports=imports,
                worktree_matches_archived_commit=current.exists() and current.read_bytes()==path.read_bytes(),
                hits=sorted(hits, key=lambda r: (r['line'],r['category'])), options=opts)

nodes, external, missing_local, cycles = {}, collections.defaultdict(set), set(), []
active = []
def walk(module):
    if module in active:
        cycles.append(active[active.index(module):]+[module]); return
    if module in nodes: return
    path = LEAN / (module.replace('.', '/') + '.lean')
    if not path.is_file():
        if module.startswith(('OAI.', 'ComparatorChallenges.')): missing_local.add(module)
        return
    active.append(module)
    nodes[module] = inspect(module)
    for child in nodes[module]['imports']:
        childpath = LEAN / (child.replace('.', '/') + '.lean')
        if childpath.is_file(): walk(child)
        else:
            external[child].add(module)
            if child.startswith(('OAI.', 'ComparatorChallenges.')): missing_local.add(child)
    active.pop()
walk(SOLUTION)
challenge = inspect(CHALLENGE)
counts = collections.Counter(hit['category'] for node in nodes.values() for hit in node['hits'])
# Raw-token scan additionally records hits obscured by comments or string masking.
raw_proof_tokens = []
for module, node in nodes.items():
    raw = (LEAN / node['path'].removeprefix('lean/')).read_text()
    for m in re.finditer(PATTERNS['proof_placeholder']+'|'+PATTERNS['axiom_declaration'],raw):
        line=raw.count('\n',0,m.start())+1
        raw_proof_tokens.append(dict(module=module,line=line,token=m.group(),source=raw.splitlines()[line-1].strip()))

def statement(module):
    code = mask_noncode((LEAN / (module.replace('.', '/') + '.lean')).read_text())
    name = 'exists_polynomial_time_language_depth_three_lower_bound'
    m = re.search(r'\btheorem\s+' + name + r'\s*:(.*?)\s*:=', code, re.S)
    if not m: return None
    return re.sub(r'\s+', ' ', m.group(1)).strip()
result = dict(
    source_commit=COMMIT,
    method='Lexical direct-import DFS in archived repository sources; nested comments and strings masked. Not a Lean parser, elaborator, declaration-dependency analyzer, axiom checker, or proof of absence of metaprogrammatic introduction of axioms.',
    solution_module=SOLUTION,
    local_closure_module_count=len(nodes),
    local_closure_bytes=sum(n['bytes'] for n in nodes.values()),
    local_closure_lines=sum(n['lines'] for n in nodes.values()),
    all_local_sources_match_worktree=all(n['worktree_matches_archived_commit'] for n in nodes.values()),
    modules_outside_depththree=[m for m in sorted(nodes) if not m.startswith('OAI.Computability.DepthThree.')],
    cycle_paths=cycles,
    missing_repository_modules=sorted(missing_local),
    external_import_boundary=[dict(module=m,imported_by=sorted(ps)) for m,ps in sorted(external.items())],
    external_boundary_module_count=len(external),
    local_hit_counts={k:counts.get(k,0) for k in PATTERNS},
    pattern_regexes=PATTERNS,
    raw_proof_or_axiom_tokens=raw_proof_tokens,
    solution_closure_includes_challenge_templates=any(m.startswith('ComparatorChallenges.') for m in nodes),
    modules=[nodes[m] for m in sorted(nodes)],
    challenge_template=challenge,
    target_statement_whitespace_normalized_equal=statement(SOLUTION)==statement(CHALLENGE),
    target_statement_whitespace_normalized=statement(SOLUTION),
    statement_comparison_limitation='Text-only statement comparison, not comparator execution or comparison of elaborated constants/definitions.',
    permitted_axioms=json.loads((LEAN/'ComparatorChallenges/DepthThree.json').read_text())['permitted_axioms'],
    theorem_axiom_dependency_verification_performed=False,
)
(SCRATCH/'static_scan.json').write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
print(json.dumps(result,indent=2,ensure_ascii=False))

