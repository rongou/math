COMMAND:
set -eu
printf "Lake command-line options (configuration not loaded)\n"
(cd lean && lake --help)
printf "\nTracked Lean tree size\n"; du -sh lean
printf "\nPinned manifest and dependency availability\n"
python3 - <<'PY'
import hashlib, json, pathlib, subprocess
root = pathlib.Path("/home/rou/src/math")
scratch = pathlib.Path("/tmp/family112-build-validation.xWSfhA")
commit = "fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"
paths = ["lean/ComparatorChallenges/README.md", "lean/ComparatorChallenges/DepthThree.json", "lean/ComparatorChallenges/DepthThree.lean", "lean/OAI/Computability/DepthThree/Main.lean", "lean/lean-toolchain", "lean/lakefile.lean", "lean/lake-manifest.json"]
fingerprints = []
for path in paths:
    data = (root / path).read_bytes()
    git_data = subprocess.check_output(["git", "show", f"{commit}:{path}"], cwd=root)
    row = dict(path=path, sha256=hashlib.sha256(data).hexdigest(), bytes=len(data), matches_source_commit=data == git_data)
    fingerprints.append(row)
    print(json.dumps(row))
    assert row["matches_source_commit"]
(scratch / "baseline_fingerprints.json").write_text(json.dumps(fingerprints, indent=2) + "\n")
manifest = json.loads((root / "lean/lake-manifest.json").read_text())
print("manifest_version", manifest["version"], "fixedToolchain", manifest.get("fixedToolchain"), "packages", len(manifest["packages"]))
for package in manifest["packages"]:
    name = package["name"].strip("«»")
    path = root / "lean/.lake/packages" / name
    print(json.dumps(dict(name=package["name"], url=package["url"], rev=package["rev"], inputRev=package["inputRev"], inherited=package["inherited"], checkout_exists=path.exists())))
PY
printf "\nCreate exact isolated snapshot, without modifying original files\n"
mkdir /tmp/family112-build-validation.xWSfhA/project
git archive fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb lean | tar -x -C /tmp/family112-build-validation.xWSfhA/project
printf "\nProtected-file snapshot equality\n"
for f in lean/lean-toolchain lean/lakefile.lean lean/lake-manifest.json; do cmp "$f" "/tmp/family112-build-validation.xWSfhA/project/$f"; sha256sum "/tmp/family112-build-validation.xWSfhA/project/$f"; done


